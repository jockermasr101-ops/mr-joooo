rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.email == "PASTE_YOUR_EMAIL"; }

    // محتوى الموقع: الكل يقرا، الأدمن بس يكتب
    match /site/config {
      allow read: if true;
      allow write: if admin() && request.resource.data.works.size() <= 60;
    }

    // طلبات الزوار: أي حد يبعت (بشروط)، الأدمن بس يقرا ويدير
    match /inbox/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','contact','service','msg','lang','st','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string && request.resource.data.contact.size() >= 5 && request.resource.data.contact.size() <= 100
        && request.resource.data.msg is string && request.resource.data.msg.size() >= 3 && request.resource.data.msg.size() <= 1500
        && request.resource.data.service is string && request.resource.data.service.size() <= 40
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 2
        && request.resource.data.st == 'new' && request.resource.data.ts == request.time;
      allow read, update, delete: if admin();
    }

    // نشاط الزوار (من غير بيانات شخصية)
    match /events/{id} {
      allow create: if request.resource.data.keys().hasOnly(['t','id','lang','m','ts'])
        && request.resource.data.t in ['view','work','wa','tg','search','like','form','media']
        && request.resource.data.id is string && request.resource.data.id.size() <= 60
        && request.resource.data.m is string && request.resource.data.m.size() <= 60
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 2
        && request.resource.data.ts == request.time;
      allow read, delete: if admin();
    }

    // إعجابات الأعمال: الكل يقرا، وأي حد يزوّد العداد 1 بس
    match /likes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if admin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
